        "end": 3.3,
        "text": "A shopkeeper slides a faded postcard across the counter."
      },
      {
        "start": 3.3,
        "end": 4.803,
        "text": "Half the picture is missing."
      },
      {
        "start": 4.803,
        "end": 6.403,
        "text": "The lane offers two leads."
      },
      {
        "start": 6.403,
        "end": 7.775,
        "text": "Which one do you follow?"
      }
    ]
  },
  "coastBoat": {
    "duration": 8.701,
    "captions": [
