        "start": 0,
        "end": 1.312,
        "text": "The boatman laughs."
      },
      {
        "start": 1.312,
        "end": 3.185,
        "text": "Every tide brings something back."
      },
      {
        "start": 3.185,
        "end": 6.621,
        "text": "He points toward a caf\u00e9 where a traveller once left a sketch."
      },
      {
        "start": 6.621,
        "end": 8.701,
        "text": "Your next clue smells like coffee."
      }
    ]
  },
