{
  "intro": {
    "duration": 9.182,
    "captions": [
      {
        "start": 0,
        "end": 2.279,
        "text": "A postcard arrived fifty years late."
      },
      {
        "start": 2.279,
        "end": 3.013,
        "text": "No name."
      },
      {
        "start": 3.013,
        "end": 3.922,
        "text": "No address."
      },
      {
        "start": 3.922,
        "end": 6.874,
        "text": "Only a clue: find what this city never lost."
      },
      {
        "start": 6.874,
        "end": 9.182,
        "text": "Chief, the next page is yours."
      }
    ]
  },
  "coast1": {
    "duration": 7.675,
    "captions": [
      {
        "start": 0,
        "end": 2.285,
        "text": "The tide leaves a small bottle on the sand."
      },
      {
        "start": 2.285,
        "end": 5.783,
        "text": "Inside: half a postcard, and a sketch of a boat."
      },
      {
        "start": 5.783,
        "end": 7.675,
        "text": "Someone nearby might know the rest."
      }
    ]
  },
  "market1": {
    "duration": 7.775,
    "captions": [
      {
